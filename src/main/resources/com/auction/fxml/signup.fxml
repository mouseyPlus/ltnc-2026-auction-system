<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<HBox prefHeight="680.0" prefWidth="1050.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.auction.controller.SignUpController">
   <children>
      <VBox prefHeight="680.0" prefWidth="420.0" spacing="20.0" style="-fx-background-color: #142B50;">
         <children>
            <HBox prefHeight="2.0" prefWidth="380.0">
               <children>
                  <Label lineSpacing="10.0" text="⚒ " textFill="WHITE">
                     <font>
                        <Font size="19.0" />
                     </font>
                  </Label>
                  <Label alignment="TOP_LEFT" text="AUCTIONFLOW" textFill="WHITE">
                     <font>
                        <Font name="Segoe UI Bold" size="18.0" />
                     </font>
                  </Label>
               </children>
            </HBox>
            <Region prefHeight="158.0" prefWidth="380.0" VBox.vgrow="ALWAYS" />
            <Label prefHeight="39.0" prefWidth="183.0" text="Bid smarter." textFill="WHITE">
               <font>
                  <Font name="Segoe UI Bold" size="30.0" />
               </font>
            </Label>
            <Label text="Win better." textFill="WHITE">
               <font>
                  <Font name="Segoe UI Bold" size="30.0" />
               </font>
            </Label>
            <Label lineSpacing="8.0" maxHeight="60.0" maxWidth="360.0" prefHeight="60.0" prefWidth="300.0" text="Discover valuable items and join live auctions with confidence." textFill="WHITE" textOverrun="CLIP" wrapText="true">
               <font>
                  <Font name="Segoe UI" size="14.0" />
               </font>
            </Label>
            <Region prefHeight="200.0" prefWidth="200.0" VBox.vgrow="ALWAYS" />
            <Label text="ONLINE AUCTION SYSTEM" textFill="#93c5fd">
               <font>
                  <Font name="Segoe UI" size="13.0" />
               </font>
            </Label>
         </children>
         <padding>
            <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
         </padding>
      </VBox>
      <ScrollPane fitToWidth="true" hbarPolicy="NEVER" prefHeight="680.0" prefWidth="630.0" HBox.hgrow="ALWAYS">
         <content>
            <VBox alignment="CENTER" prefHeight="680.0" prefWidth="630.0" spacing="14" styleClass="login-container">
            
                <padding>
                    <Insets bottom="25" left="40" right="40" top="25" />
                </padding>
            
                <Label styleClass="app-title" text="SIGN UP" textFill="#142b50">
                  <font>
                     <Font name="Segoe UI Bold" size="30.0" />
                  </font></Label>
                <Label styleClass="subtitle" text="Create your auction account">
                  <font>
                     <Font name="Segoe UI Italic" size="12.0" />
                  </font></Label>
            
                <VBox maxWidth="380" spacing="8">
            
                    <Label text="Username">
                     <font>
                        <Font name="Segoe UI Semibold" size="13.0" />
                     </font></Label>
                    <TextField fx:id="usernameField" prefHeight="32.0" promptText="Enter your username" style="-fx-background-color: #EFF6FF; -fx-background-radius: 10; -fx-border-color: #BFDBFE; -fx-border-radius: 5; -fx-border-width: 1; -fx-padding: 0 48 0 14;">
                     <font>
                        <Font name="Segoe UI" size="12.0" />
                     </font></TextField>
                  <Label fx:id="usernameErrorLabel" wrapText="true" />
            
                    <Label text="Phone number">
                     <font>
                        <Font name="Segoe UI Semibold" size="13.0" />
                     </font></Label>
                    <TextField fx:id="phoneField" prefHeight="32.0" promptText="Enter your phone number" style="-fx-background-color: #EFF6FF; -fx-background-radius: 10; -fx-border-color: #BFDBFE; -fx-border-radius: 5; -fx-border-width: 1; -fx-padding: 0 48 0 14;" />
                  <Label fx:id="phoneErrorLabel" wrapText="true" />
            
                    <Label text="Email">
                     <font>
                        <Font name="Segoe UI Semibold" size="13.0" />
                     </font></Label>
                    <TextField fx:id="emailField" prefHeight="32.0" promptText="Enter your email address" style="-fx-background-color: #EFF6FF; -fx-background-radius: 10; -fx-border-color: #BFDBFE; -fx-border-radius: 5; -fx-border-width: 1; -fx-padding: 0 48 0 14;" />
                  <Label fx:id="emailErrorLabel" wrapText="true" />
            
                    <Label text="Password">
                     <font>
                        <Font name="Segoe UI Semibold" size="13.0" />
                     </font></Label>
            
                    <StackPane>
                        <PasswordField fx:id="passwordField" prefHeight="32.0" promptText="Create a strong password" style="-fx-background-color: #EFF6FF; -fx-background-radius: 10; -fx-border-color: #BFDBFE; -fx-border-radius: 5; -fx-border-width: 1; -fx-padding: 0 48 0 14;" />
                        <TextField fx:id="visiblePasswordField" managed="false" prefHeight="32.0" promptText="Create a strong password" style="-fx-background-color: #EFF6FF; -fx-background-radius: 10; -fx-background-color: #BFDBFE; -fx-border-radius: 5; -fx-border-width: 1; -fx-padding: 0 48 0 14;" visible="false" />
                    </StackPane>
                  <Label fx:id="passwordErrorLabel" wrapText="true" />
            
                    <Label text="Confirm password">
                     <font>
                        <Font name="Segoe UI Semibold" size="13.0" />
                     </font></Label>
            
                    <StackPane>
                        <PasswordField fx:id="confirmPasswordField" prefHeight="32.0" promptText="Re-enter your password" style="-fx-background-color: #EFF6FF; -fx-background-radius: 10; -fx-border-color: #BFDBFE; -fx-border-radius: 5; -fx-border-width: 1; -fx-padding: 0 48 0 14;" />
                        <TextField fx:id="visibleConfirmPasswordField" managed="false" prefHeight="32.0" promptText="Re-enter your password" style="-fx-background-color: #EFF6FF; -fx-background-radius: 10; -fx-border-color: #BFDBFE; -fx-border-radius: 5; -fx-border-width: 1; -fx-padding: 0 48 0 14;" visible="false" />
                    </StackPane>
                  <Label fx:id="confirmPasswordErrorLabel" wrapText="true" />
            
                    <CheckBox fx:id="showPasswordCheckBox" text="Show passwords" />
            
                    <Label styleClass="hint-label" text="At least 8 characters, uppercase, lowercase, number and special character" wrapText="true">
                     <font>
                        <Font name="Segoe UI Italic" size="12.0" />
                     </font></Label>
            
                    <Button maxWidth="Infinity" onAction="#handleRegister" prefHeight="34.0" style="-fx-background-color: #DBEAFE; -fx-background-radius: 10; -fx-border-color: #93C5FD; -fx-border-radius: 5; -fx-border-width: 1; -fx-text-fill: #1D4ED8; -fx-cursor: hand;" styleClass="login-button" text="SIGN UP" textOverrun="WORD_ELLIPSIS">
                     <font>
                        <Font name="System Bold" size="15.0" />
                     </font></Button>
            
                    <Label fx:id="messageLabel" styleClass="error-label" wrapText="true" />
            
                    <HBox alignment="CENTER" spacing="5">
                        <Label text="Already have an account?">
                        <font>
                           <Font name="Segoe UI Italic" size="12.0" />
                        </font></Label>
                        <Hyperlink onAction="#handleBackToLogin" styleClass="auth-link" text="Log in" underline="true">
                        <font>
                           <Font name="Segoe UI Italic" size="12.0" />
                        </font></Hyperlink>
                    </HBox>
            
                </VBox>
            </VBox>
         </content>
      </ScrollPane>
   </children>
</HBox>
